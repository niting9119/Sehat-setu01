# ============================================================================
# Sehat Setu — Environment Configuration
# ============================================================================

# Server Port
PORT=3000

# Supabase PostgreSQL Cloud Database Configuration
# 1. Go to https://supabase.com/dashboard/project/_/settings/api
# 2. Copy "Project URL" and paste into SUPABASE_URL
# 3. Copy "anon / public" API key (or "service_role" secret key) into SUPABASE_KEY
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Admin Secret Invitation Code (Required for Admin Role Signup)
ADMIN_INVITE_CODE=ADMIN2026

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
