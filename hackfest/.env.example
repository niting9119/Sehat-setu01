# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# This exact URL must be added under Authorized redirect URIs in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
PORT=3000
ADMIN_INVITE_CODE=replace-with-a-private-admin-invitation-code
